    id = 112939, badge = "122789", published = "6/7/2020 2:20:45 PM", modified = "12/20/2025 12:27:32 PM",
    trigger = (shortSword() - prev(shortSword())) == 0x01 && prev(gold32b()) <= gold32b() && inAttractMode() != 0x00 &&
              lifeFrameCounter() != 0x00
)

