achievement(
    title = "Immortal Dragonslayer", points = 50,
    description = "Complete the game deathless without saving or acquiring a Figure of Seath",
    id = 113114, badge = "123632", published = "6/7/2020 2:53:07 PM", modified = "12/20/2025 2:11:15 PM",
    trigger = once(prev(lifeFrameCounter()) == 0x01 && prev(signedCameraUpdownAngle()) == 0x00 &&
                  prev(yCoordinate()) == 0x11800 && prev(xCoordinate()) == 0x18000 && prev(cameraRotation()) == 0x9C4 &&
                  areaId() == 0x00
              ) && never(hp() == 0x00) && trigger_when(enemy0Id() == 0x640) && trigger_when(prev(enemy0Hp()) != 0x00) &&
              trigger_when(enemy0Hp() == 0x00) && trigger_when(areaId() == 0x07) && never(loading() == 0xA01) &&
              never((prev(figureOfSeath()) == 0x00 && figureOfSeath() == 0x01))
)

achievement(
    title = "The Way of the Wizard", points = 10,
    description = "Have your Magic Power exceed your Strength Power by 10 points. Stats from equipment and items other than Verdite do not count towards the total",
    id = 113158, badge = "121594", published = "6/7/2020 3:47:00 PM", modified = "12/20/2025 12:28:31 PM",
    trigger = (magPowerWord() - strPowerWord()) == 0x0A && inAttractMode() != 0x00 && lifeFrameCounter() != 0x00
)

leaderboard(
    id = 8256, title = "End Game Experience",
    description = "",
    start  = areaId() == 0x07 && enemy0Id() == 0x640,
    cancel = hp() == 0x00,
    submit = enemy0Hp() == 0x00,
    value  = measured(experience()),
    format = "SCORE", lower_is_better = true
)

leaderboard(
    id = 8336, title = "Guardian of the shield time",
    description = "",
    start  = guardianOfTheShieldId() == 0x190 && guardianOfTheShieldHp() == 0x190 && level() == 0x01,
    cancel = always_true() &&
             ((prev(hp()) < hp()) ||
              (buttonSlot() != 0xFF) ||
              (magicEquiped() != 0xFF) ||
              (headSlot() != 0xFF) ||
              (armorSlot() != 0xFF) ||
              (shieldSlot() != 0xFF) ||
              (glovesSlot() != 0xFF) ||
              (feetSlot() != 0xFF) ||
              (item1Slot() != 0xFF) ||
              (item2Slot() != 0xFF) ||
              (weaponEquiped() != 0x00) ||
              (levelWord() != 0x01) ||
              (mp() != 0x1E)),
    submit = guardianOfTheShieldHp() == 0x00,
    value  = measured((lifeFrameCounter() * 3 + 0x00)),
    format = "FRAMES", lower_is_better = true
)
